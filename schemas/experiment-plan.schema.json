{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/super_gpu/experiment-plan.schema.json",
  "title": "super_gpu experiment plan",
  "type": "object",
  "required": ["name", "jobs"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "max_parallel": {"type": "integer", "minimum": 1},
    "defaults": {"$ref": "#/$defs/jobDefaults"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpus": {"type": "integer", "minimum": 1},
        "memory_mib": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"const": "auto"}
          ]
        },
        "gpu_utilization": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 100},
            {"const": "auto"}
          ]
        },
        "duration_seconds": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"const": "auto"}
          ]
        },
        "allow_colocation": {"type": "boolean"}
      }
    },
    "jobDefaults": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "priority": {"type": "integer"},
        "nodes": {"type": "array", "items": {"type": "string"}},
        "required_labels": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object"},
        "resources": {"$ref": "#/$defs/resources"},
        "timeout": {"type": "number", "exclusiveMinimum": 0},
        "max_retries": {"type": "integer", "minimum": 0},
        "retry_delay": {"type": "number", "minimum": 0}
      }
    },
    "job": {
      "type": "object",
      "required": ["name", "command"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"},
        "node": {"type": "string"},
        "nodes": {"type": "array", "items": {"type": "string"}},
        "required_labels": {"type": "array", "items": {"type": "string"}},
        "params": {"type": "object"},
        "env": {"type": "object"},
        "resources": {"$ref": "#/$defs/resources"},
        "timeout": {"type": "number", "exclusiveMinimum": 0},
        "max_retries": {"type": "integer", "minimum": 0},
        "retry_delay": {"type": "number", "minimum": 0},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
